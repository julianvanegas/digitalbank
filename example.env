# Puerto del servidor HTTP
SERVER_PORT=8080

# CORS (orígenes separados por comas)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Base de datos
DB_HOST=localhost:5432
DB_NAME=bank
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Pool de conexiones: máximo de conexiones simultáneas abiertas a la base de datos
DB_POOL_SIZE=10
# Flyway (migraciones de la base de datos)
FLYWAY_ENABLED=true

# Seguridad y tokens (JWT)
# Secreto para JWT (mínimo de 32 caracteres)
JWT_SECRET=dev-only-jwt-secret-change-this-value-0001
# Duración máxima del token en milisegundos; tras este tiempo se debe iniciar sesión de nuevo
JWT_EXPIRATION_MS=3600000
# Minutos de inactividad tras los cuales se cierra la sesión; cada petición renueva el plazo
SESSION_INACTIVITY_TIMEOUT_MINUTES=5
# Clave del HMAC con que se guardan los códigos de verificación 2FA (mínimo 32 caracteres)
VERIFICATION_HMAC_SECRET=dev-only-hmac-secret-change-this-value-0002
# Segundos mínimos entre dos envíos de código al mismo usuario
VERIFICATION_RESEND_INTERVAL_SECONDS=60

# Secreto que reparte la secuencia de números de cuenta en el rango de 12 dígitos (mínimo 32 caracteres)
ACCOUNT_NUMBER_SECRET=dev-only-account-secret-change-this-value-0003

# Servicio de correo (Resend)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=DigitalBank <onboarding@resend.dev>

# DEBUG: publicar documentación de la API (Swagger)
SWAGGER_ENABLED=true
