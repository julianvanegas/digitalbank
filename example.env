# CONFIGURACIÓN DEL SERVIDOR
SERVER_PORT=8080

# BASE DE DATOS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bank
DB_USERNAME=postgres
DB_PASSWORD=postgres

# SEGURIDAD Y TOKENS (JWT)
# Mínimo 32 caracteres; en producción usa un valor aleatorio propio
JWT_SECRET=dev-only-jwt-secret-change-this-value-0001
JWT_EXPIRATION_MS=3600000

# Clave del HMAC de los códigos de verificación (distinta de JWT_SECRET)
# Mínimo 32 caracteres
VERIFICATION_HMAC_SECRET=dev-only-hmac-secret-change-this-value-0002

# Segundos mínimos entre dos envíos de código al mismo usuario (opcional)
VERIFICATION_RESEND_INTERVAL_SECONDS=60

# SERVICIO DE CORREO (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=email@gmail.com
MAIL_PASSWORD=password